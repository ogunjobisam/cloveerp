// The production Worker: clove-erp, on cloveerp.com, www and every other
// subdomain. app.yml copies this over wrangler.jsonc before the build when the
// repository variable CLOVEERP_APP_ROUTES is "on"; wrangler.jsonc says why the
// two are separate files rather than one with an `env` block.
//
// The apex and www are custom domains: Cloudflare makes their DNS records and
// certificates. Every other subdomain (demo, rehearsal, each client's) arrives
// through the wildcard route, which needs one proxied DNS record, `*` AAAA
// 100::, made by hand once (a custom domain cannot be a wildcard), and the
// existing demo and rehearsal records switched to proxied. A more specific
// route wins, so status.cloveerp.com keeps its own Worker (infra/status).
// Records with no web address (mail, DKIM, Resend's) are not touched by a
// route, and links/rsend/send stay DNS-only.
{
  "name": "clove-erp",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://xpzffnnhnhcqyjqcueja.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhwemZmbm5obmhjcXlqcWN1ZWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMDIyNDIsImV4cCI6MjEwMzU3ODI0Mn0.PKnEUURM8CTNVkBjgA_pCoQJheGmL_6I7UD1-5Uywjk"
  },
  "routes": [
    { "pattern": "cloveerp.com", "custom_domain": true },
    { "pattern": "www.cloveerp.com", "custom_domain": true },
    { "pattern": "*.cloveerp.com/*", "zone_name": "cloveerp.com" }
  ]
}
