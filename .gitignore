# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Supabase CLI scratch — written by any `supabase` invocation in this tree.
supabase/.temp/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files. .env held only publishable values while it was tracked,
# but it is where a service-role key eventually lands; the names live in
# .env.example, the values live in the host.
.env
.env.*
!.env.example

# Playwright. The storage states are signed-in sessions for the two throwaway
# accounts the smoke suite uses, written by its setup project on every run; the
# reports and traces are output. None of it is worth tracking and the first is
# a bearer token, however disposable the stack that issued it.
e2e/.auth/
playwright-report/
test-results/
blob-report/

# Deno writes this when anybody runs the Edge Function typecheck locally
# (`deno check --import-map supabase/functions/import_map.json ...`). It is not
# tracked deliberately: the build resolves the same import map on a runner
# whose Deno version is its own, and a lock file recorded here would fail that
# check on an integrity mismatch rather than catching anything.
deno.lock

# Written by supabase/ops/20260908_gateway_function_bodies.sh in report-only
# mode: the CREATE OR REPLACE statements it would run against live, for a
# person to read before running them. Output, not source.
gateway_repair.sql
