{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "eslint.config.js"],
  // Generated by Lovable, imported by nothing, and already excluded from
  // eslint for the same reason: it is generated output, so the fix for its
  // complaints is to ignore it rather than to edit it. It also carries its own
  // `fetch` typing, which collides with Bun's the moment "bun" is in `types`
  // above — a collision in code no part of the app reaches.
  //
  // Worth saying plainly: these six files are a complete second Supabase
  // client stack the app bypasses for the thirty lines in src/lib/erp.ts, and
  // one of them reads SUPABASE_SERVICE_ROLE_KEY. Deleting them is the better
  // fix; excluding them is the smaller one, and this change is not the place.
  "exclude": ["src/integrations/supabase/**"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
