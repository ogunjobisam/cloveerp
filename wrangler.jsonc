// The application as a Cloudflare Worker of its own, deployed by
// .github/workflows/app.yml after a merge to main has passed the schema build
// and its database release. Until 8 October the only way the application
// reached a browser was Lovable's publish, which ships whatever is in the
// Lovable editor, proven or not, and which needs a custom domain added by hand
// for every client's subdomain.
//
// The build already makes this Worker: @lovable.dev/vite-tanstack-config runs
// nitro with the cloudflare-module preset, into .output/ (the schema build's
// typescript job reads .output/public). This file only says where it goes.
//
// Two shapes, chosen by app.yml:
//
//   top level         — workers.dev only, no routes. The address to test the
//                       Worker at before any traffic is moved to it.
//   env.production    — the same Worker on cloveerp.com, www, demo and every
//                       client's subdomain, through one wildcard route. A
//                       client added by the fleet needs no hosting step: the
//                       directory (/api/directory/<host>) already says which
//                       project a host belongs to.
//
// app.yml deploys env.production only once the repository variable
// CLOVEERP_APP_ROUTES is "on", which is the cutover: set it after the
// workers.dev deployment has been checked and cloveerp.com's DNS is on
// Cloudflare. Unset it and the next deploy leaves the routes alone; delete the
// routes in the dashboard and Lovable's publish answers again.
//
// Secrets are not here. One, set once per environment by the owner:
//
//   bunx wrangler@4 secret put SUPABASE_SERVICE_ROLE_KEY
//   bunx wrangler@4 secret put SUPABASE_SERVICE_ROLE_KEY --env production
//
// It is the control plane's (production's) service-role key, the one Lovable
// holds today: src/integrations/supabase/client.server.ts reads it for the
// server functions — the address lookup, the directory — and it must never be
// a client project's.
{
  "name": "clove-erp-staging",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // nitro's cloudflare-module handler serves the client bundle through this
  // binding; a request for a file in .output/public never reaches the Worker.
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // What the server functions read through process.env. Public by design: the
  // same URL and key are inlined in every client bundle (src/lib/backend.ts).
  "vars": {
    "SUPABASE_URL": "https://xpzffnnhnhcqyjqcueja.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhwemZmbm5obmhjcXlqcWN1ZWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMDIyNDIsImV4cCI6MjEwMzU3ODI0Mn0.PKnEUURM8CTNVkBjgA_pCoQJheGmL_6I7UD1-5Uywjk"
  },
  "env": {
    "production": {
      "name": "clove-erp",
      "workers_dev": false,
      // Vars and assets are not inherited by an environment; named again.
      "assets": {
        "directory": ".output/public",
        "binding": "ASSETS"
      },
      "vars": {
        "SUPABASE_URL": "https://xpzffnnhnhcqyjqcueja.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhwemZmbm5obmhjcXlqcWN1ZWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMDIyNDIsImV4cCI6MjEwMzU3ODI0Mn0.PKnEUURM8CTNVkBjgA_pCoQJheGmL_6I7UD1-5Uywjk"
      },
      // The apex and www are custom domains: Cloudflare makes their DNS
      // records and certificates. Every other subdomain — demo and each
      // client's — arrives through the wildcard, which needs one proxied DNS
      // record, `*` AAAA 100::, made by hand once (a custom domain cannot be a
      // wildcard). A more specific route wins, so status.cloveerp.com keeps
      // its own Worker (infra/status). Records with no web address — mail,
      // DKIM, Resend's — are not touched by a route.
      "routes": [
        { "pattern": "cloveerp.com", "custom_domain": true },
        { "pattern": "www.cloveerp.com", "custom_domain": true },
        { "pattern": "*.cloveerp.com/*", "zone_name": "cloveerp.com" }
      ]
    }
  }
}
