From e1b2ae33779bbc65aafba99194831d78f5d1889d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 12 Sep 2026 16:33:50 +0000
Subject: [PATCH] A pull request applies what it adds, and main still builds
 from nothing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The replay from an empty cluster is twenty minutes and cannot be made
much less: the 269 migrations in front of any change call the generator
definitions as they were written, so improving a generator today only
helps the migrations that come after it. The cost is structural.

But a pull request does not need that replay to learn whether it broke
something. deploy.yml already proves the cheaper model — it applies what
the live database has not seen and finishes in about a minute.

So the cache gains a second key. The exact key is the migrations as they
are here; a hit still means the work is already done. The new base key is
the migrations as they are at the merge base; a hit means a database
exists for everything except what this branch adds, and only the
additions are applied on top.

main is deliberately excluded. The claim this workflow exists to make is
that the repository reproduces the product from nothing, and a delta on a
restored base does not make it. Pull requests get the speed; main keeps
the proof.

Three guards, because a wrong base is worse than a slow build:

  - Both keys are git blob ids rather than hashFiles, which cannot read a
    tree that is not checked out. The bootstrap is in the key, so a change
    to the host surface invalidates the base rather than being skipped.
  - Only added files are applied. An edited migration is already refused
    by 'A migration is written once', and a deleted one now is too, so the
    difference between the trees can only be additions.
  - A migration sorting before one already in the base falls back to the
    full replay. This repository has had a file sort earlier than one
    already applied; applying it afterwards would build a schema no
    in-order replay produces.

Anything unexpected — no base, an unreadable dump, roles that come back
the wrong shape — still ends in the full replay. The worst case is the
build that exists today.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W2VdSJb8Tsz44kPmPhDt4M
---
 .github/workflows/schema.yml | 146 +++++++++++++++++++++++++++++++++--
 1 file changed, 140 insertions(+), 6 deletions(-)

diff --git a/.github/workflows/schema.yml b/.github/workflows/schema.yml
index bfadd7f..fc8ce84 100644
--- a/.github/workflows/schema.yml
+++ b/.github/workflows/schema.yml
@@ -159,9 +159,83 @@ jobs:
       # is no version of that worth having. Change one migration and the key
       # changes and the replay runs in full. The image tag is in the key too,
       # because the extensions come from the image.
+      - name: What this branch adds, and what a database already exists for
+        id: keys
+        # Two keys, both computed from git rather than the working tree,
+        # because one of them describes a tree this checkout is not on.
+        #
+        #   exact — the migrations as they are here. A hit means a database
+        #           built by precisely these files already exists, and the
+        #           restore below is the whole of the work.
+        #   base  — the migrations as they are on the branch this one left.
+        #           A hit means a database exists for everything except what
+        #           this branch adds, and only the additions need applying.
+        #
+        # hashFiles() cannot do the second: it reads the working tree, and the
+        # base tree is not checked out. git ls-tree gives the blob ids of both,
+        # which is a stronger statement than a content hash anyway — it is the
+        # identity git itself uses.
+        run: |
+          set -euo pipefail
+
+          tree_key() {
+            git ls-tree -r "$1" -- supabase/migrations supabase/ci/00_host_bootstrap.sql \
+              | awk '{print $3, $4}' | sort | sha256sum | cut -c1-40
+          }
+
+          base_ref=origin/${{ github.event.pull_request.base.ref || 'main' }}
+          exact="$(tree_key HEAD)"
+
+          echo "exact=$exact" >> "$GITHUB_OUTPUT"
+          echo "exact key: $exact"
+
+          # main is never built incrementally. The claim this workflow exists to
+          # make is that the repository reproduces the product from nothing, and
+          # a delta applied to a restored base does not make it. Pull requests
+          # get the speed; main keeps the proof.
+          if [[ "${{ github.ref }}" == "refs/heads/main" ]] || ! git rev-parse --verify -q "$base_ref" >/dev/null; then
+            echo "incremental=no" >> "$GITHUB_OUTPUT"
+            echo "base=" >> "$GITHUB_OUTPUT"
+            echo "this ref builds in full"
+            exit 0
+          fi
+
+          merge_base="$(git merge-base "$base_ref" HEAD)"
+          base="$(tree_key "$merge_base")"
+          echo "base=$base" >> "$GITHUB_OUTPUT"
+          echo "base key: $base (at $merge_base)"
+
+          # Only additions. An edited migration is already refused by
+          # "A migration is written once", and so now is a deleted one, so the
+          # difference between the two trees can only be files this branch adds.
+          added="$(git diff --name-only --no-renames --diff-filter=A "$merge_base..HEAD" -- 'supabase/migrations/*.sql' | sort)"
+          printf '%s\n' "$added" | sed '/^$/d' > "$RUNNER_TEMP/added_migrations.txt"
+          echo "adds $(grep -c . "$RUNNER_TEMP/added_migrations.txt" || true) migration(s)"
+
+          # A migration that sorts BEFORE one already in the base is not an
+          # addition to the end of the sequence — it is an insertion into the
+          # middle of it, and applying it afterwards is a different schema from
+          # replaying the lot in order. This repository has been bitten by a
+          # file that sorted earlier than one already applied, so the case is
+          # real. It falls back to the full replay rather than pretending.
+          newest_base="$(git ls-tree -r --name-only "$merge_base" -- supabase/migrations \
+                          | grep '\.sql$' | sort | tail -1 | xargs -r basename)"
+          out_of_order=no
+          while read -r f; do
+            [ -n "$f" ] || continue
+            if [[ "$(basename "$f")" < "$newest_base" ]]; then out_of_order=yes; fi
+          done < "$RUNNER_TEMP/added_migrations.txt"
+
+          if [[ "$out_of_order" == yes ]]; then
+            echo "::warning::a migration sorts before one already in the base; building in full"
+            echo "incremental=no" >> "$GITHUB_OUTPUT"
+          else
+            echo "incremental=yes" >> "$GITHUB_OUTPUT"
+          fi
+
       - name: A database, if these migrations have built one before
         id: schema_cache
-        uses: actions/cache@v4
+        uses: actions/cache/restore@v4
         with:
           # Three parts, because a database is not the whole of what these
           # migrations build. Roles are cluster-level, so pg_dump does not
@@ -175,8 +249,20 @@ jobs:
           # old one: an entry that cannot restore would be replayed on every
           # run and never replaced, because its key is already taken. v1 held
           # a database and no roles. v2 held roles whose attributes did not
-          # survive being applied.
-          key: clove-erp-schema-v3-pg17.6.1.167-${{ hashFiles('supabase/migrations/**', 'supabase/ci/00_host_bootstrap.sql') }}
+          # survive being applied. v4 is keyed on git blob ids rather than
+          # hashFiles, so a base tree can be named as well as this one.
+          key: clove-erp-schema-v4-pg17.6.1.167-${{ steps.keys.outputs.exact }}
+
+      - name: Or the one this branch left, to apply its additions to
+        id: base_cache
+        if: steps.schema_cache.outputs.cache-hit != 'true' && steps.keys.outputs.incremental == 'yes'
+        uses: actions/cache/restore@v4
+        with:
+          path: |
+            ${{ runner.temp }}/clove_erp.dump
+            ${{ runner.temp }}/clove_erp.roles.sql
+            ${{ runner.temp }}/clove_erp.roles.tsv
+          key: clove-erp-schema-v4-pg17.6.1.167-${{ steps.keys.outputs.base }}
 
       - name: Apply every migration, in order, to an empty database
         # --single-transaction so a migration is atomic. Without it psql
@@ -212,7 +298,9 @@ jobs:
           # NOTICEs buried the only other evidence. A step whose behaviour
           # cannot be read afterwards is a step that cannot be trusted, so it
           # announces itself.
-          echo "cache-hit: ${{ steps.schema_cache.outputs.cache-hit || 'false' }}"
+          exact_hit='${{ steps.schema_cache.outputs.cache-hit || 'false' }}'
+          base_hit='${{ steps.base_cache.outputs.cache-hit || 'false' }}'
+          echo "cache-hit: $exact_hit (exact), $base_hit (base)"
           echo "dump present: $([[ -s "$dump" ]] && echo "yes, $(wc -c < "$dump") bytes" || echo no)"
           echo "roles present: $([[ -s "$roles" ]] && echo "yes, $(wc -c < "$roles") bytes" || echo no)"
           echo "role shape present: $([[ -s "$roles_expected" ]] && echo yes || echo no)"
@@ -223,6 +311,16 @@ jobs:
               echo "── $(basename "$f")"
               $PSQL --single-transaction -f "$f"
             done
+            capture
+            echo "built from the migrations, and cached for the next run"
+          }
+
+          # What a run leaves behind for the next one. Factored out of replay()
+          # because the incremental path below produces exactly the same thing
+          # by a shorter route, and a second copy of this would be a second
+          # place for the pg_dump version trap to come back.
+          capture() {
+            set -euo pipefail
             # Dumped and restored inside the container, not on the runner.
             #
             # The runner has Ubuntu's postgresql-client, which is 16.15, and the
@@ -265,7 +363,6 @@ jobs:
             mv "$dump.new" "$dump"
             mv "$roles.new" "$roles"
             mv "$roles_expected.new" "$roles_expected"
-            echo "built from the migrations, and cached for the next run"
           }
 
           # A cache that will not restore is a cache that is ignored. Anything
@@ -332,7 +429,30 @@ jobs:
                  >> "$restore_log" 2>&1 < "$dump"; then
 
               if role_shape | diff -u "$roles_expected" - >> "$restore_log" 2>&1; then
-                echo "restored the schema these migrations built earlier"
+                if [[ "$exact_hit" == "true" ]]; then
+                  echo "restored the schema these migrations built earlier"
+                  exit 0
+                fi
+
+                # The base restored. Everything this branch does not add is
+                # already here, so only the additions are left — which is the
+                # same thing deploy.yml does to the live database, and the
+                # reason a deploy takes a minute while a replay takes twenty.
+                #
+                # Ordering was settled before the restore: a migration sorting
+                # before one already in the base sent this run to the full
+                # replay instead, because applying it afterwards would build a
+                # schema no in-order replay produces.
+                added=0
+                while read -r f; do
+                  [ -n "$f" ] || continue
+                  echo "── $(basename "$f")"
+                  $PSQL --single-transaction -f "$f"
+                  added=$((added + 1))
+                done < "$RUNNER_TEMP/added_migrations.txt"
+
+                echo "restored the base this branch left, and applied $added migration(s) on top"
+                capture
                 exit 0
               fi
               echo "::warning::the restored cluster's roles are not the ones these migrations build"
@@ -361,6 +481,20 @@ jobs:
             head -40 "$restore_log"
           fi
 
+      - name: Keep the database this run built
+        # Saved separately because the restore above is two attempts and a
+        # combined cache action can only be one. Skipped on an exact hit: the
+        # entry is already there, and writing a key that exists is a warning
+        # every run rather than a saving.
+        if: steps.schema_cache.outputs.cache-hit != 'true'
+        uses: actions/cache/save@v4
+        with:
+          path: |
+            ${{ runner.temp }}/clove_erp.dump
+            ${{ runner.temp }}/clove_erp.roles.sql
+            ${{ runner.temp }}/clove_erp.roles.tsv
+          key: clove-erp-schema-v4-pg17.6.1.167-${{ steps.keys.outputs.exact }}
+
       - name: Seed a demonstration organisation for the build to reconcile
         # Every suite cleans up after itself, so at the end of the build the
         # database holds no organisation at all — and a reconciliation over
-- 
2.43.0

